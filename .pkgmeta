# Used by the BigWigs packager (.github/workflows/release.yml) to build the CurseForge zip.
# The add-on lives in a subfolder of the repository, so it's moved to the top of the zip,
# and the files that aren't part of the add-on are left out.
package-as: Auctionator_VendorSniper

move-folders:
  Auctionator_VendorSniper/Auctionator_VendorSniper: Auctionator_VendorSniper

ignore:
  - README.md
  - CHANGELOG.md
  - media
  - tools

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
